# =========================
# Server
# =========================
PORT=5000
NODE_ENV=development

# =========================
# MongoDB Atlas
# =========================
MONGODB_URI=

# =========================
# Redis Cloud (Rate Limiting)
# =========================
REDIS_URL=

# =========================
# JWT
# =========================
JWT_SECRET=

# =========================
# Admin Credentials
# =========================
ADMIN_EMAIL=
ADMIN_PASSWORD=

# =========================
# Cloudinary (Image Uploads)
# =========================
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =========================
# Email / SMTP (Gmail)
# =========================
SMTP_EMAIL=
SMTP_PASSWORD=

# =========================
# Resend (Email fallback)
# =========================
RESEND_API_KEY=

# =========================
# Stream.io (Video Calls)
# =========================
STREAM_API_KEY=
STREAM_API_SECRET=

# =========================
# Razorpay (Payments)
# =========================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CURRENCY=INR

# =========================
# Frontend URL
# =========================
FRONTEND_URL=http://localhost:5173
